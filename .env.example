# Server
PORT=3000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/health-copilot
MONGODB_DB_NAME=health_copilot

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=health-copilot
PINECONE_TOP_K=30

# Google AI Studio (Gemini + Embeddings — same key for both)
GEMINI_API_KEY=your-google-ai-studio-key-here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_MAX_TOKENS=1500
GEMINI_TEMPERATURE=0.3
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# File Upload
UPLOAD_MAX_FILE_SIZE_MB=20
UPLOAD_TEMP_DIR=./uploads

# RAG Config
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
CONTEXT_MAX_TOKENS=3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Auth (JWT)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Frontend URL (for OAuth redirect + CORS)
FRONTEND_URL=http://localhost:5173

# Groq (LLaMA 3 — free tier: 14,400 req/day, 30 RPM — console.groq.com)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAlex (no key needed — just provide email for polite pool)
OPENALEX_EMAIL=your-email@example.com

# Research Ingestion
MAX_PAPERS_PER_SOURCE=50
MAX_CONVERSATION_HISTORY=4
FRESH_FETCH_THRESHOLD=3
MIN_RETRIEVAL_SCORE=0.5
